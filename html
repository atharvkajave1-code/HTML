<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Advanced XOX AI</title>

<style>
    * {
        box-sizing: border-box;
    }

    body {
        margin: 0;
        min-height: 100vh;
        display: flex;
        justify-content: center;
        align-items: center;
        font-family: Arial, sans-serif;
        background: linear-gradient(135deg, #111827, #312e81);
        color: white;
    }

    .game {
        width: 95%;
        max-width: 430px;
        text-align: center;
        padding: 25px;
        background: rgba(255,255,255,0.08);
        border-radius: 20px;
        box-shadow: 0 10px 40px rgba(0,0,0,0.4);
    }

    h1 {
        margin: 0 0 5px;
        font-size: 38px;
    }

    .subtitle {
        color: #cbd5e1;
        margin-bottom: 20px;
    }

    .controls {
        display: flex;
        gap: 10px;
        margin-bottom: 20px;
    }

    select,
    .control-btn {
        flex: 1;
        padding: 11px;
        border: none;
        border-radius: 10px;
        font-size: 15px;
        cursor: pointer;
    }

    select {
        background: white;
        color: #111827;
    }

    .control-btn {
        background: #4f46e5;
        color: white;
        font-weight: bold;
    }

    .scoreboard {
        display: flex;
        justify-content: space-around;
        margin-bottom: 20px;
        font-size: 18px;
    }

    .score {
        background: rgba(255,255,255,0.1);
        padding: 10px 20px;
        border-radius: 12px;
    }

    #status {
        min-height: 28px;
        font-size: 20px;
        font-weight: bold;
        margin-bottom: 18px;
    }

    #board {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 10px;
        max-width: 330px;
        margin: auto;
    }

    .cell {
        aspect-ratio: 1;
        border: none;
        border-radius: 15px;
        background: white;
        color: #111827;
        font-size: 55px;
        font-weight: bold;
        cursor: pointer;
        transition: 0.15s;
    }

    .cell:hover:not(:disabled) {
        transform: scale(1.05);
        background: #e0e7ff;
    }

    .cell:disabled {
        cursor: default;
    }

    .winning {
        background: #22c55e !important;
        color: white !important;
        transform: scale(1.04);
    }

    .x {
        color: #ef4444;
    }

    .o {
        color: #2563eb;
    }

    #newGame {
        width: 100%;
        margin-top: 20px;
        padding: 13px;
        border: none;
        border-radius: 10px;
        background: #22c55e;
        color: white;
        font-size: 17px;
        font-weight: bold;
        cursor: pointer;
    }

    .info {
        margin-top: 15px;
        font-size: 13px;
        color: #cbd5e1;
    }
</style>
</head>

<body>

<div class="game">

    <h1>⭕ XOX ❌</h1>
    <div class="subtitle">Player vs Computer AI</div>

    <div class="controls">
        <select id="difficulty">
            <option value="easy">Easy AI</option>
            <option value="medium" selected>Medium AI</option>
            <option value="hard">Hard AI</option>
        </select>

        <button class="control-btn" onclick="resetScores()">
            Reset Score
        </button>
    </div>

    <div class="scoreboard">
        <div class="score">
            You: <span id="playerScore">0</span>
        </div>

        <div class="score">
            AI: <span id="computerScore">0</span>
        </div>

        <div class="score">
            Draw: <span id="drawScore">0</span>
        </div>
    </div>

    <div id="status">Your turn — X</div>

    <div id="board">
        <button class="cell"></button>
        <button class="cell"></button>
        <button class="cell"></button>

        <button class="cell"></button>
        <button class="cell"></button>
        <button class="cell"></button>

        <button class="cell"></button>
        <button class="cell"></button>
        <button class="cell"></button>
    </div>

    <button id="newGame">New Game</button>

    <div class="info">
        You are X • Computer is O
    </div>

</div>

<script>

const cells = document.querySelectorAll(".cell");
const statusText = document.getElementById("status");
const newGameButton = document.getElementById("newGame");
const difficultySelect = document.getElementById("difficulty");

let board = ["","","","","","","","",""];

let gameActive = true;
let playerScore = 0;
let computerScore = 0;
let drawScore = 0;

const winningPatterns = [
    [0,1,2],
    [3,4,5],
    [6,7,8],
    [0,3,6],
    [1,4,7],
    [2,5,8],
    [0,4,8],
    [2,4,6]
];

cells.forEach((cell, index) => {
    cell.addEventListener("click", () => playerMove(index));
});

newGameButton.addEventListener("click", newGame);

function playerMove(index) {

    if (!gameActive || board[index] !== "") return;

    board[index] = "X";
    updateBoard();

    const result = checkGame();

    if (result) {
        finishGame(result);
        return;
    }

    gameActive = false;
    statusText.textContent = "🤖 Computer is thinking...";

    setTimeout(computerMove, 450);
}

function computerMove() {

    if (checkGame()) return;

    const difficulty = difficultySelect.value;

    let move;

    if (difficulty === "easy") {
        move = randomMove();
    }

    else if (difficulty === "medium") {
        move = Math.random() < 0.65
            ? bestMove()
            : randomMove();
    }

    else {
        move = bestMove();
    }

    board[move] = "O";

    updateBoard();

    const result = checkGame();

    if (result) {
        finishGame(result);
        return;
    }

    gameActive = true;
    statusText.textContent = "Your turn — X";
}

function randomMove() {

    const available = board
        .map((value, index) => value === "" ? index : null)
        .filter(index => index !== null);

    return available[
        Math.floor(Math.random() * available.length)
    ];
}

function bestMove() {

    let bestScore = -Infinity;
    let move;

    for (let i = 0; i < board.length; i++) {

        if (board[i] === "") {

            board[i] = "O";

            let score = minimax(board, 0, false);

            board[i] = "";

            if (score > bestScore) {
                bestScore = score;
                move = i;
            }
        }
    }

    return move;
}

function minimax(position, depth, isMaximizing) {

    const result = checkGame(position);

    if (result === "O") return 10 - depth;
    if (result === "X") return depth - 10;
    if (result === "draw") return 0;

    if (isMaximizing) {

        let bestScore = -Infinity;

        for (let i = 0; i < position.length; i++) {

            if (position[i] === "") {

                position[i] = "O";

                let score = minimax(
                    position,
                    depth + 1,
                    false
                );

                position[i] = "";

                bestScore = Math.max(bestScore, score);
            }
        }

        return bestScore;

    } else {

        let bestScore = Infinity;

        for (let i = 0; i < position.length; i++) {

            if (position[i] === "") {

                position[i] = "X";

                let score = minimax(
                    position,
                    depth + 1,
                    true
                );

                position[i] = "";

                bestScore = Math.min(bestScore, score);
            }
        }

        return bestScore;
    }
}

function checkGame(position = board) {

    for (const pattern of winningPatterns) {

        const [a,b,c] = pattern;

        if (
            position[a] !== "" &&
            position[a] === position[b] &&
            position[a] === position[c]
        ) {
            return position[a];
        }
    }

    if (!position.includes("")) {
        return "draw";
    }

    return null;
}

function finishGame(result) {

    gameActive = false;

    if (result === "X") {

        playerScore++;

        statusText.textContent = "🎉 You Win!";

    } else if (result === "O") {

        computerScore++;

        statusText.textContent = "🤖 Computer Wins!";

    } else {

        drawScore++;

        statusText.textContent = "🤝 Draw!";
    }

    updateScores();

    highlightWinner();
}

function highlightWinner() {

    for (const pattern of winningPatterns) {

        const [a,b,c] = pattern;

        if (
            board[a] !== "" &&
            board[a] === board[b] &&
            board[a] === board[c]
        ) {

            cells[a].classList.add("winning");
            cells[b].classList.add("winning");
            cells[c].classList.add("winning");

            break;
        }
    }
}

function updateBoard() {

    cells.forEach((cell, index) => {

        cell.textContent = board[index];

        cell.classList.remove("x", "o");

        if (board[index] === "X") {
            cell.classList.add("x");
        }

        if (board[index] === "O") {
            cell.classList.add("o");
        }

        cell.disabled = board[index] !== "" || !gameActive;
    });
}

function updateScores() {

    document.getElementById("playerScore").textContent =
        playerScore;

    document.getElementById("computerScore").textContent =
        computerScore;

    document.getElementById("drawScore").textContent =
        drawScore;
}

function newGame() {

    board = ["","","","","","","","",""];

    gameActive = true;

    cells.forEach(cell => {

        cell.textContent = "";

        cell.disabled = false;

        cell.classList.remove(
            "winning",
            "x",
            "o"
        );
    });

    statusText.textContent = "Your turn — X";
}

function resetScores() {

    playerScore = 0;
    computerScore = 0;
    drawScore = 0;

    updateScores();
    newGame();
}

newGame();

</script>

</body>
</html>